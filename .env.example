# Copy to .env.local for `npm run dev`. Never commit real values.
# Full reference: docs/development/ENVIRONMENT_VARIABLES.md

# --- Public (inlined into the browser bundle at BUILD time) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable key (sb_publishable_...) or legacy anon key. Safe for browsers; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Mapbox public token (pk.*), URL-restricted in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Server-only (never prefix with NEXT_PUBLIC_) ---
# Supabase secret key (sb_secret_...) or legacy service_role key. Bypasses RLS.
# In production this is a Cloudflare secret: `npx wrangler secret put SUPABASE_SECRET_KEY`.
SUPABASE_SECRET_KEY=
